cat > .gitignore <<'EOF'
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking and linting
.mypy_cache/
.ruff_cache/
.pyright/

# Jupyter Notebook
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# macOS
.DS_Store

# Logs
*.log

# Temporary files
*.tmp
*.swp
EOF